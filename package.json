{
  "name": "dsh-yunoseek-skin",
  "version": "0.2.0",
  "description": "Yunoseek pink skin for the DeepSeek Harness web GUI (pink --dsw-* token layer, yunoseek brand artwork, assistant avatar) plus the Yunoseek system-prompt injection: the identity prompt rendered as the first system-prompt section.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "tsdown",
    "build": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "devDependencies": {
    "tsdown": "^0.22.2"
  },
  "engines": {
    "node": ">=22"
  }
}